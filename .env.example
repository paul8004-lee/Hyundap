# 팀 운영자가 전달한 동일한 DB의 공개 TCP 주소와 개인별 DB 계정을 입력합니다.
# 로컬 127.0.0.1:33992는 개인 SSH 터널이므로 팀 공용 주소로 배포하지 않습니다.
# 비밀번호의 @, #, / 등은 URL 인코딩합니다. 실제 .env는 Git에 올리지 않습니다.
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:URL_ENCODED_PASSWORD@thomas.proxy.rlwy.net:27932/p3_local_control_c6e5fc8de908
DB_SSL_CA=hyundap/db/certs/railway-mysql-ca.crt

# 현재 팀 DB는 공통 인증 DB + 회사별 DB 구조입니다.
HYUNDAP_DB_LAYOUT=split
HYUNDAP_DB_COMPANY_ACCOUNTS=1
HYUNDAP_COMPANY_CREDENTIALS_SOURCE=file
# 운영자가 전달한 회사별 계정 파일을 저장소 루트에 둡니다.
# 상대 경로는 현재 터미널 폴더가 아닌 저장소 루트를 기준으로 읽습니다.
HYUNDAP_COMPANY_CREDENTIALS_FILE=.env.company-databases.json

# OpenAI 키도 운영자가 별도 전달하거나 개인 키를 사용합니다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 공통 원본/벡터 저장소를 사용한다면 운영자가 지정한 경로를 입력합니다.
UPLOAD_DIR=data/uploads
CHROMA_DB_PATH=data/chroma_db
# 앱 실행용 계정에는 DB 생성/계정 생성 권한이 필요하지 않습니다.
# DB_PROVISION_URL은 회사 등록 작업을 수행하는 운영자만 별도 설정합니다.
